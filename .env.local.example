# ================================================================
# DE GYM BALI — Environment Variables
# ================================================================
# Isi dengan kredensial Supabase project BARU Anda
# Buka: https://supabase.com > Project > Settings > API
# ================================================================

# Supabase URL (dari Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://GANTI-DENGAN-URL-PROJECT-BARU.supabase.co

# Supabase Anon Key (dari Settings > API > Project API Keys > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=GANTI-DENGAN-ANON-KEY-BARU

# WhatsApp number (format internasional tanpa +)
NEXT_PUBLIC_WA_NUMBER=6281338332112
